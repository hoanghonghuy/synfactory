# Copy to .env and chmod 600 .env before production use.
# Never commit the populated .env file.

SYNFACTORY_DOMAIN=factory.example.com
SYNFACTORY_LOCAL_API_PORT=8080
SYNFACTORY_LOCAL_WEB_PORT=8081
SYNFACTORY_ADDR=:8080

POSTGRES_USER=synfactory
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=synfactory
SYNFACTORY_DATABASE_URL=postgres://synfactory:replace-with-a-long-random-password@postgres:5432/synfactory?sslmode=disable
SYNFACTORY_DB_MAX_OPEN_CONNS=20
SYNFACTORY_DB_MAX_IDLE_CONNS=5
SYNFACTORY_DB_CONN_MAX_IDLE=5m
SYNFACTORY_DB_CONN_MAX_LIFETIME=30m

# Explicit GitHub credential mode. Use "app" in production and mount the
# private key as a read-only file. "pat" remains supported for simple/self-hosted
# installations; modes are never implicitly mixed.
SYNFACTORY_GITHUB_AUTH_MODE=pat
SYNFACTORY_GITHUB_TOKEN=replace-with-fine-grained-pat-when-using-pat-mode
SYNFACTORY_GITHUB_APP_ID=
# Host source is used only with compose.github-app.yaml. The in-container path
# is intentionally fixed and must match SYNFACTORY_GITHUB_APP_PRIVATE_KEY_FILE.
SYNFACTORY_GITHUB_APP_PRIVATE_KEY_HOST=./secrets/synfactory-github-app.pem
SYNFACTORY_GITHUB_APP_PRIVATE_KEY_FILE=/run/secrets/synfactory-github-app.pem
SYNFACTORY_GITHUB_WEBHOOK_SECRET=replace-with-webhook-secret
SYNFACTORY_GITHUB_API_URL=https://api.github.com

# Required to enable /api/v1 operator endpoints. Use a separate high-entropy
# secret; never reuse the GitHub token or webhook secret.
SYNFACTORY_OPERATOR_TOKEN=replace-with-a-long-random-operator-token

# Operator terminal is an explicit private-surface capability and is disabled by
# default. Enabling it also requires SYNFACTORY_OPERATOR_TOKEN. Use the opt-in
# compose.terminal.yaml overlay to mount target policy and SSH material only when
# terminal access is deliberately enabled.
SYNFACTORY_TERMINAL_ENABLED=false
SYNFACTORY_TERMINAL_TARGETS=/etc/synfactory/terminal-targets.json
SYNFACTORY_TERMINAL_TARGETS_HOST=./config/terminal-targets.json
SYNFACTORY_TERMINAL_SSH_DIR_HOST=./secrets/terminal-ssh
SYNFACTORY_TERMINAL_MAX_SESSIONS=2
SYNFACTORY_TERMINAL_MAX_PER_TARGET=1
SYNFACTORY_TERMINAL_IDLE_TIMEOUT=15m
SYNFACTORY_TERMINAL_MAX_LIFETIME=2h

SYNFACTORY_RECONCILE_INTERVAL=1h
SYNFACTORY_WORKFLOW_INTERVAL=1m
SYNFACTORY_EVENT_POLL_INTERVAL=3s
SYNFACTORY_EVENT_LEASE_DURATION=30s
SYNFACTORY_EVENT_MAX_ATTEMPTS=5
SYNFACTORY_LEASE_RECOVERY_INTERVAL=30s

SYNFACTORY_WIP_PM=1
SYNFACTORY_WIP_TEAM_LEAD=2
SYNFACTORY_WIP_DEVELOPER=2
SYNFACTORY_WIP_REVIEWER=2
SYNFACTORY_WIP_CI_GUARDIAN=1

# These must be ABSOLUTE host paths when the worker uses Docker sandbox mode.
# They are bind-mounted at the same absolute path inside the worker so the
# host Docker daemon can resolve nested sandbox bind mounts correctly.
SYNFACTORY_REPOSITORY_ROOT=/opt/synfactory/data/repos
SYNFACTORY_WORKSPACE_ROOT=/opt/synfactory/data/workspaces
SYNFACTORY_RUNTIME_CONFIG_HOST=./config/runtimes.local.json
SYNFACTORY_AGENT_HOME=./data/agent-home
SYNFACTORY_AGENT_BIN=./data/agent-bin

SYNFACTORY_WORKER_ID=worker-1
SYNFACTORY_WORKER_CAPACITY=1
SYNFACTORY_WORKER_POLL_INTERVAL=3s
SYNFACTORY_WORKER_LEASE_DURATION=2m
SYNFACTORY_WORKER_HEARTBEAT_INTERVAL=30s
SYNFACTORY_WORKER_STALE_AFTER=2m
SYNFACTORY_WORKER_DEFAULT_TIMEOUT=30m
SYNFACTORY_WORKER_RETRY_BASE=30s

SYNFACTORY_TASK_RESERVATION_TTL=10m
SYNFACTORY_SHUTDOWN_TIMEOUT=20s
SYNFACTORY_LOG_LEVEL=info

# Optional API-key runtimes. CLI logins may instead be persisted under
# SYNFACTORY_AGENT_HOME when supported by that CLI.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
CURSOR_API_KEY=
SYNFACTORY_ROUTER_API_KEY=
